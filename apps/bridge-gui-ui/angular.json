{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bridge-gui-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            // ADR: 生成先は UI パッケージ自身の `dist` に置き、dev と prod を
            // 別ディレクトリに分ける（混在の罠の排除。prod 成果物を dev 包装に
            // 詰めない）。Hutch の `copy` は相対配置の安定ファイル名を要求する
            // ため、`outputHashing: none` で固定名（main.js 等）にし、再帰 build
            // には型検査だけでなく production AOT を含める。独立 lockfile は持たない。
            "outputPath": "dist/prod",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [],
            "styles": ["src/styles.css"],
            "outputHashing": "none",
            // ADR: 同梱フォント（`src/assets/fonts`）を成果物へ運ぶ。固定名のまま
            // `assets/` 配下に置き、`styles.css` の `@font-face` から参照する。
            "assets": ["src/assets"]
          },
          "configurations": {
            "production": {
              "budgets": [],
              "outputHashing": "none",
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": false
            },
            "development": {
              "outputPath": "dist/dev",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            // ADR: 公式の Vitest runner で TestBed 試験を行う。
            // `vp test`（vite-plus）の対象は `tests/` のままとし、ng test は
            // 既定 include（`src/**/*.spec.ts`）だけを拾う。watch は切って
            // `vp run -r test` の一部として確実に終了させる。
            // `zone.js` は試験運用だけの依存である（実行束には入れない）。
            // 公式 builder が `zone.js/testing` の解決を要求し、pnpm が
            // `@angular/core` の peer として恒久的に実体を置くため、
            // 宣言を外すと未連結の残骸だけが残り束ねに失敗する。
            // 実行時は読み込まない（`main.ts` に import は無い）。
            "runner": "vitest",
            "watch": false
          }
        }
      }
    }
  },
  "cli": {
    // 解析の送信は無効にし、`ng` による追記物の混入を防ぐ。
    "analytics": false
  }
}
