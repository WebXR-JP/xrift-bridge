{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bridge-gui-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            // ADR: 生成先は bridge-gui の view 素材置き場に直書きする。
            // Hutch の `copy` は相対配置の安定ファイル名を要求するため、
            // `outputHashing: none` で固定名（main.js 等）にし、再帰 build には混ぜず
            // opt-in の `ng:build:*` だけで作る。独立 lockfile は持たない。
            "outputPath": "../bridge-gui/src/mainview-ng/dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [],
            "styles": ["src/styles.css"],
            "outputHashing": "none",
            "assets": []
          },
          "configurations": {
            "production": {
              "budgets": [],
              "outputHashing": "none",
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            // ADR: 公式の Vitest runner で TestBed 試験を行う。
            // `vp test`（vite-plus）の対象は `tests/` のままとし、ng test は
            // 既定 include（`src/**/*.spec.ts`）だけを拾う。watch は切って
            // `vp run -r test` の一部として確実に終了させる。
            // `zone.js` は試験運用だけの依存である（実行束には入れない）。
            // 公式 builder が `zone.js/testing` の解決を要求し、pnpm が
            // `@angular/core` の peer として恒久的に実体を置くため、
            // 宣言を外すと未連結の残骸だけが残り束ねに失敗する。
            // 実行時は読み込まない（`main.ts` に import は無い）。
            "runner": "vitest",
            "watch": false
          }
        }
      }
    }
  }
}
