{
  "name": "bridge-gui",
  "version": "0.0.0",
  "private": true,
  "description": "XRift Bridge の管理画面（Electrobun によるデスクトップ GUI。段1スパイク）。",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vp test",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "check": "vp check",
    "gui:prepare": "hutch electrobun prepare",
    "gui:dev": "hutch run dev",
    "gui:build:dev": "hutch electrobun build --env=dev",
    "gui:run": "hutch electrobun build --env=dev && hutch electrobun run",
    "gui:build": "hutch run build"
  },
  "dependencies": {
    "bridge-app-core": "workspace:*",
    "bridge-protocol": "workspace:*",
    "bridge-server": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "world-client": "workspace:*"
  }
}
