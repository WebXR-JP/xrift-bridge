{
  "name": "bridge-server",
  "version": "0.0.0",
  "description": "PC上で動作するブリッジのサーバーコア。GUI/CLIが利用する管理境界。",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "bridge-protocol": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "world-client": "catalog:"
  }
}
