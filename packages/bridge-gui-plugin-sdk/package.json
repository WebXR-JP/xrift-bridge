{
  "name": "bridge-gui-plugin-sdk",
  "version": "0.0.0",
  "description": "GUI プラグイン実装者が参照する公開 SDK 契約。管理記述子・companion の公開面・登録口の型だけを持ち、具象プラグインやホスト実装を持たない。",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./assets": "./dist/assets.mjs",
    "./companion": "./dist/companion.mjs",
    "./management": "./dist/management.mjs",
    "./registration": "./dist/registration.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "bridge-app-core": "workspace:*",
    "bridge-gui-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
